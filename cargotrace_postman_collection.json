{
  "info": {
    "_postman_id": "cargotrace-api-v1",
    "name": "CargoTrace REST API - UAS Web Programming 2",
    "description": "Comprehensive Postman collection for CargoTrace Global Shipment Visibility Platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Operator)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operator@cargotrace.com\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "Login (Customer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@globaltrade.com\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "Get Authenticated User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/user", "host": ["{{base_url}}"], "path": ["user"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] }
          }
        }
      ]
    },
    {
      "name": "2. Shipments",
      "item": [
        {
          "name": "List Shipments (Pagination & Filters)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/shipments?status=IN_TRANSIT&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["shipments"],
              "query": [
                { "key": "status", "value": "IN_TRANSIT" },
                { "key": "per_page", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Shipment Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/shipments/1", "host": ["{{base_url}}"], "path": ["shipments", "1"] }
          }
        },
        {
          "name": "Create Shipment (Operator/Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 3,\n  \"carrier_id\": 1,\n  \"origin_id\": 1,\n  \"destination_id\": 4,\n  \"cargo_type\": \"High-Precision Robotics\",\n  \"total_weight_kg\": 12500,\n  \"total_volume_cbm\": 32.4,\n  \"expected_departure_at\": \"2026-12-01 08:00:00\",\n  \"expected_arrival_at\": \"2026-12-18 16:00:00\",\n  \"notes\": \"Handle with care. Nitrogen cushion required.\",\n  \"items\": [\n    {\n      \"item_description\": \"Articulated Robotic Arm Modules\",\n      \"hs_code\": \"8479.50\",\n      \"quantity\": 40,\n      \"weight_kg\": 8000,\n      \"volume_cbm\": 20\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/shipments", "host": ["{{base_url}}"], "path": ["shipments"] }
          }
        },
        {
          "name": "Transition Status (State Machine)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"BOOKED\",\n  \"description\": \"Carrier slot booking confirmed aboard vessel.\"\n}"
            },
            "url": { "raw": "{{base_url}}/shipments/4/transition", "host": ["{{base_url}}"], "path": ["shipments", "4", "transition"] }
          }
        },
        {
          "name": "Get Tracking Timeline",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/shipments/1/tracking", "host": ["{{base_url}}"], "path": ["shipments", "1", "tracking"] }
          }
        },
        {
          "name": "Add Historical Waypoint",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"SUEZ_CANAL_TRANSIT\",\n  \"description\": \"Vessel convoy entered northern canal sector on schedule.\",\n  \"latitude\": 30.5852,\n  \"longitude\": 32.2654\n}"
            },
            "url": { "raw": "{{base_url}}/shipments/1/tracking", "host": ["{{base_url}}"], "path": ["shipments", "1", "tracking"] }
          }
        }
      ]
    },
    {
      "name": "3. Exceptions",
      "item": [
        {
          "name": "List Exceptions for Shipment",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/shipments/1/exceptions", "host": ["{{base_url}}"], "path": ["shipments", "1", "exceptions"] }
          }
        },
        {
          "name": "Raise Exception",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exception_type\": \"WEATHER_DELAY\",\n  \"severity\": \"MEDIUM\",\n  \"root_cause\": \"Severe tropical cyclone forecast in Bay of Bengal requiring speed reduction.\"\n}"
            },
            "url": { "raw": "{{base_url}}/shipments/1/exceptions", "host": ["{{base_url}}"], "path": ["shipments", "1", "exceptions"] }
          }
        },
        {
          "name": "Resolve Exception",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolution_notes\": \"Customs clearance stamp received after verified battery certification audit.\"\n}"
            },
            "url": { "raw": "{{base_url}}/exceptions/1", "host": ["{{base_url}}"], "path": ["exceptions", "1"] }
          }
        }
      ]
    },
    {
      "name": "4. Master Data",
      "item": [
        {
          "name": "List Carriers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/carriers", "host": ["{{base_url}}"], "path": ["carriers"] }
          }
        },
        {
          "name": "List Locations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/locations", "host": ["{{base_url}}"], "path": ["locations"] }
          }
        }
      ]
    }
  ]
}
